---
// src/layouts/BaseLayout.astro

const { 
  title = "Neurobotics | Edge-Native Autonomous Systems", 
  robots 
} = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    
    <!-- 2. The dynamic title injection -->
    <title>{title}</title>

    <!-- 3. The Crawler Cloak: It only renders if a page specifically asks for it -->
    {robots && <meta name="robots" content={robots} />}
    
    <link rel="icon" type="image/png" href="/bubo-neural-owl-logo.ico?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Aldrich&display=swap" rel="stylesheet">
    
    <style is:global>
body {
        margin: 0;
        background-color: #050511; 
        color: white;
        font-family: sans-serif;
      }
      
      /* --- THE GAP KILLER --- */
      main {
        margin-bottom: 0 !important;
        padding-bottom: 0 !important;
      }
      
      /* --- THE STICKY HEADER --- */
      header {
        position: sticky;
        top: 0;
        z-index: 1000;
        background-color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 50px;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.5);
      }

      .logo-container {
        display: flex;
        align-items: center;
        gap: 15px;
      }

      .logo-text {
        color: #0a1128;
        font-size: 1.8rem;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 2px;
      }

      .tm-mark {
    font-size: 0.4em; /* Uses the same relative sizing magic! */
    vertical-align: super;
  }

      /* --- NAVIGATION MENU --- */
      .menu-links {
        display: flex;
        align-items: center;
      }

      .menu-links a, .dropbtn {
        margin-left: 20px;
        text-decoration: none;
        color: #0a1128;
        font-weight: bold;
        font-size: 1rem;
        background: none;
        border: none;
        cursor: pointer;
        font-family: sans-serif;
      }

      /* --- PURE CSS DROPDOWN --- */
      .dropdown {
        position: relative;
        display: inline-block;
      }

      .dropdown-content {
        display: none; /* This HIDES the box by default */
        position: absolute;
        right: 0; 
        background-color: white;
        min-width: 220px;
        box-shadow: 0px 8px 16px rgba(0,0,0,0.2);
        z-index: 1001;
        border-top: 3px solid #0a1128;
      }

      .dropdown-content a {
        color: #0a1128;
        padding: 12px 16px;
        text-decoration: none;
        display: block;
        margin-left: 0; 
        text-align: left;
      }

      .dropdown-content a:hover {
        background-color: #f1f1f1;
      }

      /* When you hover over the 'dropdown' area, it changes 'display: none' to 'display: block' */
      .dropdown:hover .dropdown-content {
        display: block;
      }

      /* --- FOOTER STYLES --- */
      footer {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center; 
        padding: 60px 40px 40px 40px; 
        background-color: #000000;
      }

      /* The three invisible layout boxes */
      .footer-left { display: flex; justify-content: flex-start; }
      .footer-center { display: flex; flex-direction: column; align-items: center; text-align: center; }
      .footer-right { display: flex; flex-direction: column; align-items: flex-end; text-align: right; }

      /* 1. TAMES THE GIANT OWL! */
      .footer-logo {
        width: 70px; 
        height: auto;
        margin-bottom: 15px; 
      }
      
      /* 2. Bumps up the company text */
      .company-info {
        font-size: 1.25rem; 
        font-weight: 400; 
        margin-bottom: 15px;
        margin-top: 0; 
      }

      /* 3. Fixes the default dark blue link color */
      .footer-email {
        color: #ffffff; 
        font-size: 1.1rem;
        text-decoration: none; 
        transition: color 0.3s ease;
      }

      .footer-email:hover {
        color: #d4af37; 
      }

      /* 4. Dims the copyright text */
      .copyright-text {
        color: #888888; 
        font-size: 0.85rem; 
        margin-top: 5px; 
      }

      /* 5. SOCIAL ICONS */
      .social-icons { display: flex; gap: 20px; }
      .social-icons a { color: #888888; transition: color 0.3s ease; display: block; }
      .social-icons svg { width: 24px; height: 24px; fill: currentColor; }
      
      .social-icons a.icon-x:hover { color: #ffffff; }
      .social-icons a.icon-li:hover { color: #149ee9; }
      .social-icons a.icon-fb:hover { color: #0c4897; }
      .social-icons a.icon-yt:hover { color: #ff0000; }

/* --- 5. SOCIAL ICONS --- */
      .social-icons {
        display: flex;
        gap: 25px;
        margin-top: 25px; /* Spacing below the email */
        align-items: center;
        justify-content: center;
      }

      .social-icons a {
        color: #888888; /* Matches your copyright text nicely */
        transition: color 0.3s ease;
        display: block; 
      }

      .social-icons svg {
        width: 24px;  /* This tames the infinite vectors! */
        height: 24px;
        fill: currentColor; 
      }

      /* The Hover Colors */
      .social-icons a.icon-x:hover { color: #ffffff; }
      .social-icons a.icon-li:hover { color: #4678e6; }
      .social-icons a.icon-fb:hover { color: #2a5da0; }
      .social-icons a.icon-yt:hover { color: #ff0000; }

    </style>
  </head>
  
  <body>
    <header>
      <div class="logo-container">
        <img src="/assets/images/neurobotics-bubo-neural-owl-logo-best.png" alt="Neurobotics Logo" height="60">
        <span class="logo-text">Neurobotics<span class="tm-mark">&trade;</span></span>
      </div>
      
     <nav class="menu-links">
      <a href="/">Home</a>
      <a href="/sbud">SBUD</a>
      <a href="/bubo-sbalf">SBALF</a>
      <a href="/nbpr-2026-1050">Silicon Consciousness</a>
      <a href="/neurotronic-brain">Neurotronic Brain</a>
      
      <div class="dropdown">
        <button class="dropbtn">More ▾</button>
        <div class="dropdown-content">
          <a href="/white-papers">The White Papers</a>
          <a href="/renshaw-theory">Renshaw Theory</a>
          <a href="/#publications-demos">Publications & Demos</a>
          <a href="/about-us">About Us</a>
          <a href="/safety">Safety First</a>
          <a href="/licensing">Licensing</a>
        </div>
      </div>
    </nav>
    </header>

    <main>
      <slot /> 
    </main>

   <footer>
      <div class="footer-left">
        <div class="social-icons">
          <a href="https://x.com/NeuroboticsSci" target="_blank" rel="noopener noreferrer" class="icon-x" aria-label="X">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/NeuroboticsSci" target="_blank" rel="noopener noreferrer" class="icon-li" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.603 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.facebook.com/NeuroboticsSci/" target="_blank" rel="noopener noreferrer" class="icon-fb" aria-label="Facebook">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.youtube.com/@NeuroboticsSci" target="_blank" rel="noopener noreferrer" class="icon-yt" aria-label="YouTube">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-center">
        <img src="/assets/images/neurobotics-bubo-neural-owl-logo-best.png" alt="Neurobotics Logo" class="footer-logo">
        <p class="copyright-text">© 2026 Kenneth & Shannon Renshaw / Neurobotics</p>
      </div>

      <div class="footer-right">
        <p class="company-info">Neurobotics, LLC<br>Yale, Oklahoma<br>918-399-7019</p>
        <a href="mailto:info@NeuroboticsSci.ai" class="footer-email">info@NeuroboticsSci.ai</a>
      </div>
    </footer>

  </body>
</html>