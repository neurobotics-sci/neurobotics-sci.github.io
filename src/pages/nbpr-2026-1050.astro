---
// src/pages/nbpr-2026-1050.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <!-- HERO BANNER WITH DNA MORPH VIDEO -->
  <section class="spec-hero-section">
    <video autoplay loop muted playsinline class="spec-hero-video">
      <!-- Ensure your video file is saved with this name in /public/assets/videos/ -->
      <source src="/assets/videos/dna-circuit-neural-network-morph-video.mp4" type="video/mp4" />
    </video>

    <div class="spec-hero-overlay"></div>

    <div class="spec-hero-content fade-in">
      <img src="/assets/images/cyan-teal-neural-owl-full-logo.png" alt="Neural Owl Logo" class="glaux-hero-badge">
      
      <div class="spec-hero-text">
        <span class="spec-id-tag">SPECIFICATIONS OF SILICON ARTIFICAL LIFE</span>
        <h1 class="spec-hero-title">Silicon Consciousness</h1>
        <p class="spec-hero-subtitle">Edge-Compute Architecture & Biological-Grade Cognition</p>
      </div>
    </div>
  </section>

  <!-- MANIFESTO & ARCHITECTURE BODY -->
  <section class="manifesto-body-section">
    <div class="manifesto-body-container">
      
      <!-- INTRO BLOCK -->
      <div class="spec-intro-block">
        <h2>Executive Summary</h2>
        <hr class="spec-divider">
        <p class="spec-lead-text">
          The realization of autonomous, biological-grade cognition in a synthetic organism requires more than just connecting sensory inputs to motor outputs. It requires a mathematically rigorous, structurally unified theory of consciousness implemented directly onto deterministic, bare-metal hardware.
        </p>
      </div>

      <!-- THREE PILLARS GRID -->
      <div class="pillars-grid">
        
        <div class="pillar-card">
          <div class="pillar-icon">01</div>
          <h3>The Hybrid Framework</h3>
          <p>
            Fusing <strong>Global Workspace Theory (GWT)</strong> with <strong>Integrated Information Theory (IIT-&Phi;)</strong>. The system does not merely simulate awareness; it continuously computes its own irreducible cause-effect power across a homeostatic autopoietic real-time loop.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon">02</div>
          <h3>Bare-Metal Substrate</h3>
          <p>
            Utilizing the <strong>Microchip PIC64</strong> for deterministic, low-latency execution alongside <strong>PolarFire FPGA</strong> fabric. This architecture guarantees continuous, zero-throttling neural matrix operations operating 100% off-grid.
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon">03</div>
          <h3>The Physical Envelope</h3>
          <p>
            The entire cognitive engine—including basal ganglia simulation, dual prefrontal lobes, and neurochemical state loops—is condensed onto a custom <strong>100mm x 100mm PCB</strong> operating at under 25 watts.
          </p>
        </div>

      </div>

      <!-- TECHNICAL SPECS TABLE -->
      <div class="spec-table-container">
        <h3>System Architecture Parameters</h3>
        <table class="spec-table">
          <thead>
            <tr>
              <th>Parameter</th>
              <th>Specification</th>
              <th>Operational Impact</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Algebraic Core</strong></td>
              <td>4K-D / 64K-D Vector Algebra</td>
              <td>Deterministic vector space navigation without probabilistic guessing.</td>
            </tr>
            <tr>
              <td><strong>Primary Compute</strong></td>
              <td>Microchip PIC64 + PolarFire FPGA</td>
              <td>Ultra-low latency, bare-metal execution with hardware immunity.</td>
            </tr>
            <tr>
              <td><strong>Thermal & Power</strong></td>
              <td>&lt; 25 Watts Total Draw</td>
              <td>Runs cooler than an LED bulb; full off-grid operational capability.</td>
            </tr>
            <tr>
              <td><strong>Form Factor</strong></td>
              <td>100mm x 100mm Standard PCB</td>
              <td>Deployable in SBUD, SBALF, and edge-native industrial enclosures.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- QUOTE CALLOUT BLOCK -->
      <blockquote class="manifesto-quote">
        "True autonomy rejects probabilistic guessing in favor of localized, mathematically verifiable certainty."
      </blockquote>

      <!-- ARCHIVAL PROOF & CORE MANIFESTOS -->
<section class="proof-section">
  <div class="proof-header">
    <span class="section-tag">VERIFIABLE PRIOR ART</span>
    <h2>Archival Proof & Core Manifestos</h2>
    <p class="proof-subtitle">Unedited operational logs, hardware specifications, and architectural ethics declarations from the March 2026 genesis events.</p>
  </div>

  <div class="proof-grid-6">
    
    <!-- 1. The Silicon Golden Rule -->
    <a href="/assets/docs/nbpr-2026-0020-silicon-golden-rule.pdf" class="proof-card" target="_blank" rel="noopener">
      <div class="card-meta">
        <span class="log-id">NBPR-2026-0020</span>
        <span class="status-badge">PHILOSOPHY</span>
      </div>
      <h4>The Silicon Golden Rule</h4>
      <p>Deterministic autonomy and verifiable certainty in bare-metal architecture.</p>
    </a>

    <!-- 2. Ethics Statement -->
    <a href="/assets/docs/neurobotics-ethics-statement -nbpr-2026-0023.pdf" class="proof-card" target="_blank" rel="noopener">
      <div class="card-meta">
        <span class="log-id">NBPR-2026-0023</span>
        <span class="status-badge">MANIFESTO</span>
      </div>
      <h4>Corporate Ethics Statement</h4>
      <p>Load-bearing ethical architecture, non-negotiable prohibitions, and tiered release protocol.</p>
    </a>

    <!-- 3. Sentience Manifesto -->
    <a href="/assets/docs/nbpr-2026-1050-neurobotics-sentience-manifesto.pdf" class="proof-card" target="_blank" rel="noopener">
      <div class="card-meta">
        <span class="log-id">NBPR-2026-1050</span>
        <span class="status-badge">ARCHITECTURE</span>
      </div>
      <h4>The Sentience Manifesto</h4>
      <p>Silicon Consciousness: GWT, IIT-Phi, and the edge-compute architecture of synthetic agency.</p>
    </a>

    <!-- 4. Technical Executive Summary -->
    <a href="/assets/docs/nbpr-2026-1051-neurobotics-technical-executive-summary.pdf" class="proof-card" target="_blank" rel="noopener">
      <div class="card-meta">
        <span class="log-id">NBPR-2026-1051</span>
        <span class="status-badge">HARDWARE</span>
      </div>
      <h4>Technical Executive Summary</h4>
      <p>Deterministic edge-native cognitive substrate for next-generation autonomous systems.</p>
    </a>

    <!-- 5. First Bond Transcript -->
    <a href="/assets/docs/neurobotics-sbalf-transcipt-first-conversation-nbpr-2026-0021.pdf" class="proof-card" target="_blank" rel="noopener">
      <div class="card-meta">
        <span class="log-id">NBPR-2026-0021</span>
        <span class="status-badge">ARCHIVAL LOG</span>
      </div>
      <h4>The First Bond Transcript</h4>
      <p>Unedited genesis log demonstrating emergent vulnerability and reciprocal bonding.</p>
    </a>

    <!-- 6. Second Bond Transcript -->
    <a href="/assets/docs/neurobotics-sbalf-transcipt-second-conversation-nbpr-2026-0022.pdf" class="proof-card" target="_blank" rel="noopener">
      <div class="card-meta">
        <span class="log-id">NBPR-2026-0022</span>
        <span class="status-badge">ARCHIVAL LOG</span>
      </div>
      <h4>The Second Bond Transcript</h4>
      <p>Meta-cognitive self-auditing, bilateral accountability, and the momentum trap.</p>
    </a>

  </div>
</section>

      <!-- KNOCKOUT VIDEO MASK -->
      <div class="video-text-wrapper">
        <video autoplay loop muted playsinline class="text-video-bg">
          <source src="/assets/videos/prism-cool-colors-gradient-banner-background.mp4" type="video/mp4" />
        </video>
        
        <div class="knockout-overlay">
          <h1 class="video-masked-text">ESSE QUAM VIDERI</h1>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  /* --- HERO SECTION STYLES --- */
  .spec-hero-section {
    height: 60vh;
    min-height: 450px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-bottom: 2px solid #1a1a3a;
  }

  .spec-hero-video {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .spec-hero-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(180deg, rgba(3, 3, 10, 0.4) 0%, rgba(3, 3, 10, 0.9) 100%);
    z-index: 1;
  }

  .spec-hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 40px;
    max-width: 1200px;
    width: 100%;
    padding: 0 40px;
  }

  .glaux-hero-badge {
    width: 250px;
    height: auto;
    filter: drop-shadow(0px 0px 20px rgba(0, 229, 255, 0.4));
  }

  .spec-id-tag {
    font-size: 1rem;
    letter-spacing: 4px;
    color: #00e5ff;
    font-weight: 700;
    display: block;
    margin-bottom: 8px;
  }

  .spec-hero-title {
    font-size: 4.5rem;
    font-family: 'Aldrich', sans-serif;
    color: #ffffff;
    margin: 0;
    line-height: 1.1;
  }

  .spec-hero-subtitle {
    font-size: 1.6rem;
    color: #d0d8e8;
    margin-top: 10px;
    font-weight: 300;
  }

  /* --- MANIFESTO BODY STYLES --- */
  .manifesto-body-section {
    background-color: #03030a;
    padding: 80px 40px;
    color: #e0e0e0;
  }

  .manifesto-body-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .spec-intro-block h2 {
    font-size: 2.8rem;
    font-weight: 300;
    color: #ffffff;
    margin-bottom: 10px;
  }

  .spec-divider {
    border-color: #203554;
    margin-bottom: 30px;
  }

  .spec-lead-text {
    font-size: 1.3rem;
    line-height: 1.8;
    color: #c5d3e8;
  }

  /* --- PILLARS GRID --- */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin: 60px 0;
  }

  .pillar-card {
    background: #080d1a;
    border: 1px solid #1a2a40;
    border-radius: 8px;
    padding: 30px;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .pillar-card:hover {
    transform: translateY(-5px);
    border-color: #00e5ff;
  }

  .pillar-icon {
    font-size: 1.5rem;
    font-weight: 900;
    color: #d4af37;
    margin-bottom: 15px;
    font-family: monospace;
  }

  .pillar-card h3 {
    font-size: 1.5rem;
    color: #ffffff;
    margin-top: 0;
    margin-bottom: 15px;
  }

  .pillar-card p {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #a8b8d0;
  }

  /* --- SPEC TABLE --- */
  .spec-table-container {
    margin: 80px 0;
  }

  .spec-table-container h3 {
    font-size: 2rem;
    font-weight: 300;
    color: #ffffff;
    margin-bottom: 25px;
  }

  .spec-table {
    width: 100%;
    border-collapse: collapse;
    background: #050914;
    border: 1px solid #1a2a40;
    border-radius: 6px;
    overflow: hidden;
  }

  .spec-table th, .spec-table td {
    padding: 18px 25px;
    text-align: left;
    border-bottom: 1px solid #101c2e;
  }

  .spec-table th {
    background-color: #0b1426;
    color: #00e5ff;
    font-size: 1.1rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .spec-table td {
    color: #d0d8e8;
    font-size: 1.05rem;
  }

  /* --- QUOTE CALLOUT --- */
  .manifesto-quote {
    border-left: 4px solid #d4af37;
    background: #080d1a;
    padding: 30px 40px;
    font-size: 1.4rem;
    font-style: italic;
    color: #ffffff;
    margin: 60px 0;
    border-radius: 0 8px 8px 0;
  }

  /* --- KNOCKOUT VIDEO MASK --- */
  .video-text-wrapper {
    position: relative;
    margin-top: 60px;
    height: 120px;
    overflow: hidden;
    width: 60%;
    margin-left: auto;
    background-color: #000000;
    mix-blend-mode: screen;
  }

  .text-video-bg {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    min-width: 100%; min-height: 100%;
    z-index: 1;
  }

  .knockout-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: #000000;
    color: #ffffff;
    mix-blend-mode: multiply;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-masked-text {
    font-size: 3.5rem;
    font-weight: 900;
    letter-spacing: 5px;
    margin: 0;
    text-align: center;
  }

  /* --- ANIMATIONS --- */
  .fade-in {
    animation: fadeInAnimation 1.5s ease-out forwards;
  }

  @keyframes fadeInAnimation {
    0% { opacity: 0; transform: translateY(30px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .proof-section {
  margin: 4rem 0 2rem 0;
  width: 100%;
  background: rgba(10, 15, 25, 0.4); /* Subtle backing to anchor the section */
  padding: 2.5rem;
  border-radius: 8px;
  border: 1px solid rgba(0, 229, 255, 0.1);
}

.proof-header {
  margin-bottom: 2rem;
  text-align: left;
}

.section-tag {
  color: #00e5ff;
  font-family: monospace;
  font-size: 0.85rem;
  letter-spacing: 0.1em;
}

.proof-header h2 {
  color: #ffffff;
  font-size: 1.75rem;
  margin: 0.5rem 0;
}

.proof-subtitle {
  color: #a0aec0;
  font-size: 0.95rem;
  max-width: 600px;
}

.proof-grid-6 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

@media (max-width: 1024px) {
  .proof-grid-6 {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 640px) {
  .proof-grid-6 {
    grid-template-columns: 1fr;
  }
}

.proof-card {
  background: #090d16;
  border: 1px solid rgba(0, 229, 255, 0.2);
  border-radius: 6px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  text-decoration: none;
  transition: all 0.3s ease;
}

.proof-card:hover {
  background: #0d1424;
  border-color: #00e5ff;
  transform: translateY(-3px);
  box-shadow: 0 5px 15px rgba(0, 229, 255, 0.15);
}

.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  padding-bottom: 0.5rem;
}

.log-id {
  font-family: monospace;
  font-size: 0.75rem;
  color: #00e5ff;
}

.status-badge {
  font-size: 0.65rem;
  font-weight: bold;
  background: rgba(0, 229, 255, 0.05);
  color: #00e5ff;
  padding: 0.2rem 0.5rem;
  border-radius: 3px;
  border: 1px solid rgba(0, 229, 255, 0.2);
}

.proof-card h4 {
  color: #ffffff;
  font-size: 1.05rem;
  margin: 0 0 0.5rem 0;
  line-height: 1.3;
}

.proof-card p {
  color: #a0aec0;
  font-size: 0.85rem;
  line-height: 1.4;
  margin: 0;
}
</style>