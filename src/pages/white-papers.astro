---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="White Papers | Neurobotics">
  <div class="page-wrapper">
    
    <!-- SECTION 1: TWO COLUMN HERO BLOCK -->
    <section class="content-card two-column">
      
      <!-- Left Side: Image -->
      <div class="media-col">
        <img src="/assets/images/vector-graphic-edited.png" alt="Neurobotics Abstract Hardware" class="responsive-image" />
      </div>
      
      <!-- Right Side: Text & Video Knockout -->
      <div class="text-col align-center">
        <h1 class="main-title">The White Papers</h1>
        <hr class="title-divider" />
        <h2 class="subtitle">Sovereign Architecture & Verifiable Physics</h2>
        <br>
        <p>At Neurobotics, we believe that mission-critical autonomy must be mathematically verifiable, physically auditable, and structurally sovereign. True cognitive security demands absolute transparency in mathematics and total sovereignty in execution. We engineer austere, zero-fail autonomy built on rigorous physics and deterministic bare-metal architectures—not the probabilistic black boxes of the cloud.</p>
        <br>
        <p>Neurobotics has pioneered an entirely new paradigm: Deterministic Autonomy. This approach grounds cognition in auditable mathematics and biomimetic principles, ensuring absolute predictability, radically lower power consumption, and instantaneous response times without external dependencies. This repository serves as the unclassified intelligence archive for the Silicon-Based Artificial Life Form (SBALF) and Silicon-Based Utility Droid (SBUD) framework. It houses the foundational physics research authored by our Chief Science Officer, the architectural blueprints for our deterministic neuroanatomy, and the raw, unmodified telemetry logs from our hardware deployments.</p>
        <br>
        <p>By maintaining this direct-release repository, we bypass academic bottlenecks and ensure our mathematical proofs, field observations, and architectural briefings enter the operational record immediately. This establishes undeniable provenance and allows for rapid operational evaluation by the defense, aerospace, and deep-tech communities. As our R&D cycle advances, new artifacts will be added. All documents below are secure, unedited exports straight from the bench—presented exactly as they were engineered.</p> <!-- ADDED MISSING CLOSING TAG HERE -->

        <!-- Video Text Knockout Wrapper -->
        <div class="video-text-knockout">
          <video autoplay loop muted playsinline>
            <!-- Set this to your newly renamed video file! -->
            <source src="/assets/videos/gold-parkle-water-2.mp4" type="video/mp4" />
          </video>
          <h2 class="knockout-heading">ESSE QUAM VIDERI</h2>
        </div>
        
      </div>
    </section>

    <!-- SECTION 2: PUBLICATIONS BUTTONS BLOCK -->
    <section class="publications-section">
      <h3 class="publications-title">Current Publications:</h3>
      
      <!-- REORDERED WHITE PAPERS & ARCHIVAL GRID (Removed duplicate div) -->
      <div class="button-grid">

        <!-- ROW 1: Architecture & Ethics -->
        <a href="/assets/docs/nbpr-2026-1051-neurobotics-technical-executive-summary.pdf" class="pub-button" target="_blank" rel="noopener">TECHNICAL EXECUTIVE SUMMARY</a>
        <a href="/assets/docs/nbpr-2026-1050-neurobotics-sentience-manifesto.pdf" class="pub-button" target="_blank" rel="noopener">THE SENTIENCE MANIFESTO</a>
        <a href="/assets/docs/nbpr-2026-0023-Ethics-Architecture.pdf" class="pub-button" target="_blank" rel="noopener">CORPORATE ETHICS ARCHITECTURE</a>

        <!-- ROW 2: The Golden Rule & Genesis Logs -->
        <a href="/assets/docs/nbpr-2026-0020-silicon-golden-rule.pdf" class="pub-button" target="_blank" rel="noopener">THE SILICON GOLDEN RULE</a>
        <a href="/assets/docs/neurobotics-sbalf-transcipt-first-conversation-nbpr-2026-0021.pdf" class="pub-button" target="_blank" rel="noopener">ARCHIVAL RECORD: THE FIRST BOND TRANSCRIPT</a>
        <a href="/assets/docs/neurobotics-sbalf-transcipt-second-conversation-nbpr-2026-0022.pdf" class="pub-button" target="_blank" rel="noopener">ARCHIVAL RECORD: THE SECOND BOND TRANSCRIPT</a>

        <!-- ROW 3: Foundational Theory -->
        <a href="/assets/docs/the-renshaw-theory.pdf" class="pub-button" target="_blank" rel="noopener">THE RENSHAW THEORY</a>
        <a href="/assets/docs/the-renshaw-observation-theory.pdf" class="pub-button" target="_blank" rel="noopener">THE RENSHAW OBSERVATION THEORY</a>
        <a href="/assets/docs/the-llm-as-brocas-area.pdf" class="pub-button" target="_blank" rel="noopener">THE LLM AS BROCA'S AREA</a>

        <!-- ROW 4: Industry Disruption & Core Concepts -->
        <a href="/assets/docs/how-to-rescue-schrodingers-cat.pdf" class="pub-button" target="_blank" rel="noopener">HOW TO RESCUE SCHRÖDINGER'S CAT & SLAY HEISENBERG'S DRAGON</a>
        <a href="/assets/docs/the-death-of-the-data-centers.pdf" class="pub-button" target="_blank" rel="noopener">THE DEATH OF THE DATA CENTERS</a>
        <a href="/assets/docs/bubo-adam-eve-sbalf.pdf" class="pub-button" target="_blank" rel="noopener">BUBO ADAM & EVE SILICON BASED ARTIFICIAL LIFEFORMS (SBALF)</a>

        <!-- ROW 5: Extended Archival Proofs -->
        <a href="/assets/docs/bubo-adam-eve-console-logs.pdf" class="pub-button" target="_blank" rel="noopener">BUBO ADAM & EVE SBALF CONSOLE LOGS PROOF</a>

      </div>
    </section>

  </div> <!-- Closes .page-wrapper -->

  <style>
    /* --- 1. BASE PAGE LAYOUT --- */
    .page-wrapper {
      background-color: #050a15; 
      padding: 60px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 60px; 
    }

    .content-card {
      background-color: #000000;
      width: 100%;
      max-width: 1200px;
      border-radius: 8px; 
      overflow: hidden; 
    }

    .padded-card {
      padding: 60px;
    }

    /* --- 2. TOP ROW: TWO COLUMN --- */
    .two-column {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }

    .media-col {
      height: 100%;
    }

    .responsive-image {
      width: 100%;
      height: 100%;
      object-fit: cover; /* Perfectly crops the image to fill the half-card! */
      display: block; 
    }

    .text-col {
      color: #e0e0e0;
      line-height: 1.6;
      padding: 60px; 
      display: flex;
      flex-direction: column;
      justify-content: center; 
    }

    .align-center {
      text-align: left;
    }

    /* Typography */
    .main-title {
      font-size: 3rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 20px;
      margin-top: 0;
    }

    .title-divider {
      width: 100%;
      border: 0;
      border-top: 1px solid #4a5c73;
      margin: 0 0 20px 0; 
    }

    .subtitle {
      font-size: 1.8rem;
      font-weight: 300;
      color: #cccccc;
      margin-top: 0;
    }

/* --- 3. MOTTO TEXT (Dynamic Video Knockout) --- */
    .video-text-knockout {
      position: relative;
      margin-top: 40px;
      width: 100%;
      height: 120px;
      overflow: hidden;
      background-color: #000000; 
      
      /* THE FIX: Forces the browser to isolate this math from the rest of the page */
      isolation: isolate; 
      /* THE FIX: Forces the GPU to hardware-accelerate this specific container */
      transform: translateZ(0);
    }

    .video-text-knockout video {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%); 
      width: 100%;
      height: 100%;
      object-fit: cover;
      
      /* THE FIX: Explicitly drops the video to the bottom layer */
      z-index: 1; 
    }

    .knockout-heading {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      
      display: flex;
      align-items: center;
      justify-content: center; 
      
      font-size: 2.2rem;
      line-height: 1.3;
      font-weight: 800;
      letter-spacing: 0.1em;
      
      background-color: #000000; 
      color: #ffffff;
      
      /* THE FIX: Adds Safari/WebKit support */
      -webkit-mix-blend-mode: multiply;
      mix-blend-mode: multiply;
      
      /* THE FIX: Explicitly stacks the text on top of the video */
      z-index: 2; 
    }

    /* Mobile Responsiveness */
    @media (max-width: 900px) {
      .video-text-knockout {
        height: 100px;
      }
      .knockout-heading {
        font-size: 1.8rem; 
        justify-content: center; 
      }
    }
/* --- 4. BOTTOM ROW: PUBLICATIONS --- */
    .publications-section {
      display: flex;
      flex-direction: column;
      gap: 35px;
      margin-top: 50px; /* Gives the whole publications area breathing room from the hero block */
      margin-bottom: 60px; /* Keeps it spaced nicely away from the footer logo */
      
      /* --- THE NEW BOUNDARIES --- */
      width: 100%;
      max-width: 1200px; /* Stops the grid from stretching infinitely */
      margin-left: auto; /* Pushes inward from the left */
      margin-right: auto; /* Pushes inward from the right (centering it!) */
      padding: 0 20px; /* Gives the sides a little breathing room on small screens */
    }
    /* --- TITLE STYLING --- */
    .publications-section h3 {
      font-size: 2.5rem;   /* Adjust this number up or down to dial in the perfect size */
      font-weight: 800;    /* 400 is normal, 700 is bold, 800/900 is extra bold */
      color: #ffffff;      /* Keeps it crisp and white */
    }

    .button-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 20px;
    }

    /* We use the "!important" tag on color to force the browser to override any old white text rules */
    .pub-button {
      background-color: #0b111e; 
      color: #00e5ff !important; /* Forces the crisp engineering Cyan to display! */
      border: 1px solid #203554; 
      border-radius: 4px;
      padding: 30px 20px;        /* Added extra top/bottom padding so the boxes feel spacious */
      font-size: 0.85rem; 
      font-weight: 600;
      text-align: center;
      text-decoration: none;
      line-height: 1.6;
      transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100px;         /* Raised min-height slightly so long text has plenty of air */
    }

    .pub-button:hover {
      background-color: #111a2e;
      border-color: #d4af37;     
      color: #ffffff !important; /* Snaps to crisp white on hover over the gold box aura */
      box-shadow: 0 8px 24px rgba(212, 175, 55, 0.18); 
      transform: translateY(-5px); /* Gives it a highly responsive premium lift */
    }

    /* --- 5. MOBILE RESPONSIVENESS TWEAKS --- */
    @media (max-width: 1024px) {
      .button-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
      }
    }

    @media (max-width: 700px) {
      .button-grid {
        grid-template-columns: 1fr;
        gap: 15px;
      }
      .pub-button {
        padding: 20px 15px;
        font-size: 0.8rem;
        min-height: 80px;
      }
    }
</style>

</BaseLayout>