---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Media Room & EPK | Neurobotics" robots="noindex, nofollow">
  <div class="page-wrapper">
    
    <!-- SECTION 1: TWO COLUMN HERO BLOCK -->
    <section class="content-card two-column">
      
      <!-- Left Side: Image -->
      <div class="media-col">
        <!-- You can swap this image for a high-res shot of the chassis or studio -->
        <img src="/assets/images/media-briefcase-steampunk-brain-diagrams.jpeg" alt="Neurobotics Media Vault" class="responsive-image" />
      </div>
      
      <!-- Right Side: Text & Video Knockout -->
      <div class="text-col align-center">
        <h1 class="main-title">Media & Press Archive</h1>
        <hr class="title-divider" />
        <h2 class="subtitle"><strong>Official Electronic Press Kit (EPK)</strong></h2>
        <br>
        <p>This repository serves as the official media archive for Neurobotics. Access to this directory is provisioned for approved journalists, broadcast producers, and media partners.</p>
        <br>
        <p>The assets contained within include broadcast-ready B-roll, high-resolution hardware photography, executive biographies, and corporate branding materials.</p>
        <br>
        <p><strong>All assets below are cleared for editorial use. Please send us an email request for custom footage or specific interview needs.</strong></p>
        
        <!-- Video Text Knockout Wrapper -->
        <div class="video-text-knockout">
          <video autoplay loop muted playsinline>
            <source src="/assets/videos/bright-neon-background.mp4" type="video/mp4" />
          </video>
          <h2 class="knockout-heading">ESSE QUAM VIDERI</h2>
        </div>
        
      </div>
    </section>

    <!-- SECTION 2: THE VAULT LIBRARY BLOCK -->
    <section class="publications-section">
      
      <!-- FOLDER 1: CORPORATE BRIEFS & BIOS -->
      <h3 class="publications-title">[ 01 ] Corporate Briefs & Bios</h3>
      <div class="button-grid">
        <a href="/assets/media//neurobotics-company-fact-sheet.pdf" class="pub-button" target="_blank" rel="noopener">COMPANY FACT SHEET</a>
        <a href="/assets/media/neurobotics-executive-biographies.pdf" class="pub-button" target="_blank" rel="noopener">EXECUTIVE BIOGRAPHIES</a>
        <a href="/assets/media/neurobotics-technical-primer.pdf" class="pub-button" target="_blank" rel="noopener">"UNLIKE LLMs" TECHNICAL PRIMER</a>
      </div>

      <!-- FOLDER 2: BROADCAST B-ROLL & VIDEO -->
      <h3 class="publications-title folder-spacing">[ 02 ] Broadcast B-Roll (1080p)</h3>
      <div class="media-grid">
        <!-- Media Card 1 -->
        <div class="media-card">
          <img src="/assets/images/bubo-is-alive-thumbnail.jpg" alt="Bubo Tracking B-Roll" class="media-thumbnail">
          <a href="/assets/media/b-roll-bubo-tracking.mp4" class="pub-button card-btn" download>DOWNLOAD CHASSIS TRACKING</a>
        </div>
        <!-- Media Card 2 -->
        <div class="media-card">
          <img src="/assets/images/connectome-studio-thumbnail.jpg" alt="Connectome Studio B-Roll" class="media-thumbnail">
          <a href="/assets/media/b-roll-connectome-telemetry.mp4" class="pub-button card-btn" download>DOWNLOAD CONNECTOME TELEMETRY</a>
        </div>
        <!-- Media Card 3 -->
        <div class="media-card">
          <img src="/assets/images/prior-art-notebook-thumbnail.jpg" alt="Prior Art Notebook B-Roll" class="media-thumbnail">
          <a href="/assets/media/b-roll-computation-notebook.mp4" class="pub-button card-btn" download>DOWNLOAD COMPUTATION NOTEBOOK</a>
        </div>
      </div>

      <!-- FOLDER 3: HIGH-RESOLUTION PHOTOGRAPHY -->
      <h3 class="publications-title folder-spacing">[ 03 ] High-Resolution Photography (300 DPI)</h3>
      <div class="media-grid">
        <!-- Media Card 1 -->
        <div class="media-card">
          <img src="/assets/images/founders-portrait-thumbnail.jpg" alt="Founders Portrait" class="media-thumbnail">
          <a href="/assets/media/photo-renshaw-founders.zip" class="pub-button card-btn" download>DOWNLOAD FOUNDERS PORTRAIT</a>
        </div>
        <!-- Media Card 2 -->
        <div class="media-card">
          <img src="/assets/images/bubo-hardware-thumbnail.jpg" alt="Mark XX Hardware" class="media-thumbnail">
          <a href="/assets/media/photo-mark-xx-chassis.zip" class="pub-button card-btn" download>DOWNLOAD MARK XX HARDWARE</a>
        </div>
        <!-- Media Card 3 -->
        <div class="media-card">
          <img src="/assets/images/neural-board-thumbnail.jpg" alt="Neural Board Close Up" class="media-thumbnail">
          <a href="/assets/media/photo-neural-boards.zip" class="pub-button card-btn" download>DOWNLOAD NEURAL BOARDS MACRO</a>
        </div>
      </div>

      <!-- FOLDER 4: BRAND ASSETS & LOGOS -->
      <h3 class="publications-title folder-spacing">[ 04 ] Brand Assets & Logos</h3>
      <div class="button-grid">
        <a href="/assets/media/neurobotics-primary-logo.svg" class="pub-button" download>PRIMARY LOGO (SVG)</a>
        <a href="/assets/media/neurobotics-owl-crest-transparent.png" class="pub-button" download>OWL CREST (TRANSPARENT PNG)</a>
        <a href="/assets/media/neurobotics-brand-hex-codes.pdf" class="pub-button" target="_blank" rel="noopener">BRAND COLORS & HEX CODES</a>
      </div>

    </section>
  </div>

  <style>
    /* --- 1. BASE PAGE LAYOUT --- */
    .page-wrapper {
      background-color: #050a15; 
      padding: 60px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 60px; 
    }

    .content-card {
      background-color: #000000;
      width: 100%;
      max-width: 1200px;
      border-radius: 8px; 
      overflow: hidden; 
    }

    /* --- 2. TOP ROW: TWO COLUMN --- */
    .two-column {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }

    .media-col {
      height: 100%;
    }

    .responsive-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block; 
    }

    .text-col {
      color: #e0e0e0;
      line-height: 1.6;
      padding: 60px; 
      display: flex;
      flex-direction: column;
      justify-content: center; 
    }

    .align-center {
      text-align: left;
    }

    /* Typography */
    .main-title {
      font-size: 3rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 20px;
      margin-top: 0;
    }

    .title-divider {
      width: 100%;
      border: 0;
      border-top: 1px solid #00e5ff;
      margin: 0 0 20px 0; 
    }

    .subtitle {
      font-size: 1.8rem;
      font-weight: 300;
      color: #cccccc;
      margin-top: 0;
    }

    /* --- 3. MOTTO TEXT (Dynamic Video Knockout) --- */
    .video-text-knockout {
      position: relative;
      margin-top: 40px;
      width: 100%;
      height: 120px; 
      overflow: hidden;
      background-color: #000000; 
      isolation: isolate; 
    }

    .video-text-knockout video {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%); 
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -1; 
    }

    .knockout-heading {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: center; 
      font-size: 2.2rem; 
      line-height: 1.3;  
      font-weight: 800;
      letter-spacing: 0.1em;
      background-color: #000000; 
      color: #ffffff;
      mix-blend-mode: multiply;
      z-index: 1; 
    }

    /* --- 4. BOTTOM ROW: VAULT LIBRARY --- */
    .publications-section {
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-top: 20px; 
      margin-bottom: 60px; 
      width: 100%;
      max-width: 1200px; 
      margin-left: auto; 
      margin-right: auto; 
      padding: 0 20px; 
    }
    
    /* --- TITLE STYLING --- */
    .publications-title {
      font-size: 2rem;   
      font-weight: 700;    
      color: #ffffff;      
      border-bottom: 1px solid #203554;
      padding-bottom: 10px;
      margin-bottom: 10px;
    }

    .folder-spacing {
      margin-top: 50px; 
    }

    .button-grid, .media-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 20px;
    }

    .pub-button {
      background-color: #0b111e; 
      color: #00e5ff !important; 
      border: 1px solid #203554; 
      border-radius: 4px;
      padding: 25px 20px;        
      font-size: 0.85rem; 
      font-weight: 600;
      text-align: center;
      text-decoration: none;
      line-height: 1.6;
      transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 90px;         
    }

    .pub-button:hover {
      background-color: #111a2e;
      border-color: #d4af37;     
      color: #ffffff !important; 
      box-shadow: 0 8px 24px rgba(212, 175, 55, 0.18); 
      transform: translateY(-5px); 
    }

    /* --- NEW: MEDIA CARD STYLING FOR PHOTOS/VIDEO --- */
    .media-card {
      background-color: #0b111e;
      border: 1px solid #203554;
      border-radius: 4px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: all 0.3s ease;
    }

    .media-card:hover {
      border-color: #00e5ff;
      box-shadow: 0 8px 24px rgba(0, 229, 255, 0.15);
      transform: translateY(-5px); 
    }

    .media-thumbnail {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      background-color: #000;
      border-bottom: 1px solid #203554;
    }

    /* Adjusts the standard pub-button to fit inside the media card */
    .card-btn {
      border: none !important;
      border-radius: 0 !important;
      min-height: 70px !important;
      box-shadow: none !important;
      transform: none !important;
    }

    .media-card:hover .card-btn {
      background-color: #111a2e;
      color: #ffffff !important;
    }

    /* --- 5. MOBILE RESPONSIVENESS TWEAKS --- */
    @media (max-width: 1024px) {
      .button-grid, .media-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
      }
    }

    @media (max-width: 700px) {
      .two-column {
        grid-template-columns: 1fr;
      }
      .button-grid, .media-grid {
        grid-template-columns: 1fr;
        gap: 15px;
      }
      .pub-button {
        padding: 20px 15px;
        font-size: 0.8rem;
        min-height: 80px;
      }
    }
  </style>
</BaseLayout>