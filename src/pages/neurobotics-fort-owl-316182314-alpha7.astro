---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<!-- 
  The robots prop ensures search engines do not index this private vault.
  Ensure BaseLayout.astro renders this in the <head> tag!
-->
<BaseLayout title="Executive Vault | Neurobotics" robots="noindex, nofollow">
  <div class="page-wrapper">
    
    <!-- SECTION 1: TWO COLUMN HERO BLOCK -->
    <section class="content-card two-column">
      
      <!-- Left Side: Image -->
      <div class="media-col">
        <img src="/assets/images/safe-lock-technology-steampunk-bubo-patina-badge.png" alt="Neurobotics Abstract Hardware" class="responsive-image" />
      </div>
      
      <!-- Right Side: Text & Video Knockout -->
      <div class="text-col align-center">
        <h1 class="main-title">Neurobotics Data Room Vault</h1>
        <hr class="title-divider" />
        <h2 class="subtitle"><strong>Secure Intelligence Archive</strong></h2>
        <br>
        <p>This repository serves as the secure, unlisted intelligence archive for Neurobotics. Access to this directory is strictly provisioned for active due diligence, internal operations, and designated capital partners.</p>
        <br>
        <p>The artifacts contained within detail the architectural blueprints, legal framework, and capital allocation strategy for the Silicon-Based Artificial Life Form (SBALF) and Silicon-Based Utility Droid (SBUD) frameworks. We engineer austere, zero-fail autonomy built on rigorous physics—our corporate structure and operational expenditures reflect that exact same deterministic discipline.</p>
        <br>
        <p><strong>All documents below are secure, unedited exports directly from Neurobotics. Please treat the enclosed technical specifications and intellectual property with strict confidentiality.</strong></p>
        
        <!-- Video Text Knockout Wrapper -->
        <div class="video-text-knockout">
          <video autoplay loop muted playsinline>
            <source src="/assets/videos/liquid-smoke-background-with-glow.mp4" type="video/mp4" />
          </video>
          <h2 class="knockout-heading">ESSE QUAM VIDERI</h2>
        </div>
        
      </div>
    </section>

    <!-- SECTION 2: THE VAULT LIBRARY BLOCK -->
    <section class="publications-section">
      
      <!-- FOLDER 1: EXECUTIVE & FINANCIALS -->
      <h3 class="publications-title">[ 01 ] Executive & Financials</h3>
      <div class="button-grid">
        <a href="/assets/docs-fort-owl/neurobotics-main-pitch-deck.pdf" class="pub-button" target="_blank" rel="noopener">MASTER PITCH DECK</a>
        <a href="/assets/docs-fort-owl/corporate-profile-and-complaince.pdf" class="pub-button" target="_blank" rel="noopener">CORPORATE PROFILE & COMPLIANCE</a>
        <a href="/assets/docs-fort-owl/neurobotics-seed-capital-allocation.pdf" class="pub-button" target="_blank" rel="noopener">SEED TERM SHEET & USE OF FUNDS</a>
      </div>

      <!-- FOLDER 2: CORPORATE & LEGAL -->
      <h3 class="publications-title folder-spacing">[ 02 ] Corporate & Legal</h3>
      <div class="button-grid">
        <a href="/assets/docs-fort-owl/neurobotics-llc-formation-operating-agreement.pdf" class="pub-button" target="_blank" rel="noopener">LLC FORMATION & OPERATING AGREEMENT</a>
        <a href="/assets/docs-fort-owl/neurobotics-ip-assignment-agreement.pdf" class="pub-button" target="_blank" rel="noopener">IP ASSIGNMENT AGREEMENT</a>
        <a href="/assets/docs-fort-owl/neurobotics-master-brand-ui-architecture.pdf" class="pub-button" target="_blank" rel="noopener">NEUROBOTICS MASTER BRAND & UI ARCHITECTURE</a>
      </div>

      <!-- FOLDER 3: CORE ARCHITECTURE & ETHICS -->
      <h3 class="publications-title folder-spacing">[ 03 ] Core Architecture & Ethics</h3>
      <div class="button-grid">
        <a href="/assets/docs-fort-owl/nbpr-2026-1051-neurobotics-technical-executive-summary.pdf" class="pub-button" target="_blank" rel="noopener">TECHNICAL EXECUTIVE SUMMARY</a>
        <a href="/assets/docs-fort-owl/nbpr-2026-1050-neurobotics-sentience-manifesto.pdf" class="pub-button" target="_blank" rel="noopener">THE SENTIENCE MANIFESTO</a>
        <a href="/assets/docs-fort-owl/neurobotics-ethics-statement-nbpr-2026-0023.pdf" class="pub-button" target="_blank" rel="noopener">CORPORATE ETHICS STATEMENT</a>
      </div>

      <!-- FOLDER 4: ENGINEERING & PRIOR ART -->
      <h3 class="publications-title folder-spacing">[ 04 ] Engineering & Prior Art</h3>
      <div class="button-grid">
        <!-- Update these two links once Kenneth's files are named and uploaded -->
        <a href="/assets/docs-fort-owl/master-asset-provenance-architectural-genesis.pdf" class="pub-button" target="_blank" rel="noopener">MASTER ASSET PROVENANCE & ARCHITECTUAL GENESIS</a>
        <a href="/assets/docs-fort-owl/hardware-substrate-schematics.pdf" class="pub-button" target="_blank" rel="noopener">HARDWARE SUBSTRATE SCHEMATICS</a>
        <a href="/assets/docs-fort-owl/nbpr-2026-0020-silicon-golden-rule.pdf" class="pub-button" target="_blank" rel="noopener">THE SILICON GOLDEN RULE</a>
      </div>

      <!-- FOLDER 5: ARCHIVAL PROOFS & TRAJECTORY -->
      <h3 class="publications-title folder-spacing">[ 05 ] Commercialization & Future Trajectory</h3>
      <div class="button-grid">
        <a href="/assets/docs-fort-owl/engineering-roadmap-phase-1-alpha-demo.pdf" class="pub-button" target="_blank" rel="noopener">ROADMAP TO PHASE 1 ALPHA DEMO</a>
        <a href="/assets/docs-fort-owl/neurobotics-commercial-licensing-prospectus.pdf" class="pub-button" target="_blank" rel="noopener">COMMERCIAL LICENSING PROSPECTUS</a>
        <a href="/assets/docs-fort-owl/strategic-technology-briefing-miniaturization-medical-potential.pdf" class="pub-button" target="_blank" rel="noopener">MEDICAL & BIO-CYBERNETIC HORIZONS</a>
      </div>

    </section>
  </div>

  <style>
    /* --- 1. BASE PAGE LAYOUT --- */
    .page-wrapper {
      background-color: #050a15; 
      padding: 60px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 60px; 
    }

    .content-card {
      background-color: #000000;
      width: 100%;
      max-width: 1200px;
      border-radius: 8px; 
      overflow: hidden; 
    }

    /* --- 2. TOP ROW: TWO COLUMN --- */
    .two-column {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }

    .media-col {
      height: 100%;
    }

    .responsive-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block; 
    }

    .text-col {
      color: #e0e0e0;
      line-height: 1.6;
      padding: 60px; 
      display: flex;
      flex-direction: column;
      justify-content: center; 
    }

    .align-center {
      text-align: left;
    }

    /* Typography */
    .main-title {
      font-size: 3rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 20px;
      margin-top: 0;
    }

    .title-divider {
      width: 100%;
      border: 0;
      border-top: 1px solid #00e5ff;
      margin: 0 0 20px 0; 
    }

    .subtitle {
      font-size: 1.8rem;
      font-weight: 300;
      color: #cccccc;
      margin-top: 0;
    }

    /* --- 3. MOTTO TEXT (Dynamic Video Knockout) --- */
    .video-text-knockout {
      position: relative;
      margin-top: 40px;
      width: 100%;
      height: 120px; 
      overflow: hidden;
      background-color: #000000; 
      isolation: isolate; /* FIX: Forces the blend mode to stay inside this specific container */
    }

    .video-text-knockout video {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%); 
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -1; /* FIX: Pushes the video firmly beneath the text layer */
    }

    .knockout-heading {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: center; 
      font-size: 2.2rem; 
      line-height: 1.3;  
      font-weight: 800;
      letter-spacing: 0.1em;
      
      /* THE MAGIC LAYER */
      background-color: #000000; /* FIX: Changed from #050a15 to pure black to match the parent card */
      color: #ffffff;
      mix-blend-mode: multiply;
      z-index: 1; /* FIX: Locks the text mask directly on top of the video */
    }

    /* --- 4. BOTTOM ROW: VAULT LIBRARY --- */
    .publications-section {
      display: flex;
      flex-direction: column;
      gap: 20px; /* Reduced gap between title and grid */
      margin-top: 20px; 
      margin-bottom: 60px; 
      width: 100%;
      max-width: 1200px; 
      margin-left: auto; 
      margin-right: auto; 
      padding: 0 20px; 
    }
    
    /* --- TITLE STYLING --- */
    .publications-title {
      font-size: 2rem;   
      font-weight: 700;    
      color: #ffffff;      
      border-bottom: 1px solid #203554;
      padding-bottom: 10px;
      margin-bottom: 10px;
    }

    /* Adds breathing room between the bottom of one grid and the title of the next folder */
    .folder-spacing {
      margin-top: 50px; 
    }

    .button-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 20px;
    }

    .pub-button {
      background-color: #0b111e; 
      color: #00e5ff !important; 
      border: 1px solid #203554; 
      border-radius: 4px;
      padding: 25px 20px;        
      font-size: 0.85rem; 
      font-weight: 600;
      text-align: center;
      text-decoration: none;
      line-height: 1.6;
      transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 90px;         
    }

    .pub-button:hover {
      background-color: #111a2e;
      border-color: #d4af37;     
      color: #ffffff !important; 
      box-shadow: 0 8px 24px rgba(212, 175, 55, 0.18); 
      transform: translateY(-5px); 
    }

    /* --- 5. MOBILE RESPONSIVENESS TWEAKS --- */
    @media (max-width: 1024px) {
      .button-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
      }
    }

    @media (max-width: 700px) {
      .button-grid {
        grid-template-columns: 1fr;
        gap: 15px;
      }
      .pub-button {
        padding: 20px 15px;
        font-size: 0.8rem;
        min-height: 80px;
      }
    }
  </style>
</BaseLayout>